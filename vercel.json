{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/yonetim", "destination": "/api/index" },
    { "source": "/yonetim/:path*", "destination": "/api/index" },
    { "source": "/duyurular/:slug", "destination": "/api/index" },
    { "source": "/duyurular/:slug/", "destination": "/api/index" },
    { "source": "/etkinlikler/:slug", "destination": "/api/index" },
    { "source": "/etkinlikler/:slug/", "destination": "/api/index" },
    { "source": "/sitemap.xml", "destination": "/api/index" },
    { "source": "/robots.txt", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/static/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ],
  "crons": [{ "path": "/api/saglik/", "schedule": "0 6 * * *" }]
}
