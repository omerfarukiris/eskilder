{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "bash scripts/vercel_derle.sh",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/yonetim",
      "destination": "/api/index"
    },
    {
      "source": "/yonetim/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/duyurular/:slug",
      "destination": "/api/index"
    },
    {
      "source": "/duyurular/:slug/",
      "destination": "/api/index"
    },
    {
      "source": "/etkinlikler/:slug",
      "destination": "/api/index"
    },
    {
      "source": "/etkinlikler/:slug/",
      "destination": "/api/index"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/saglik/",
      "schedule": "0 6 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/anasayfa.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/i/anasayfa.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/hakkinda.html",
      "destination": "/hakkimizda",
      "permanent": true
    },
    {
      "source": "/i/hakkinda.html",
      "destination": "/hakkimizda",
      "permanent": true
    },
    {
      "source": "/duyurular.html",
      "destination": "/duyurular",
      "permanent": true
    },
    {
      "source": "/i/duyurular.html",
      "destination": "/duyurular",
      "permanent": true
    },
    {
      "source": "/duyuru.html",
      "destination": "/duyurular",
      "permanent": true
    },
    {
      "source": "/i/duyuru.html",
      "destination": "/duyurular",
      "permanent": true
    },
    {
      "source": "/iletisim.html",
      "destination": "/iletisim",
      "permanent": true
    },
    {
      "source": "/i/iletisim.html",
      "destination": "/iletisim",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/i/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/duyurular_:eski.html",
      "destination": "/duyurular",
      "permanent": true
    }
  ]
}
